# Скопируйте в .env и поменяйте пароль/секрет перед публикацией.
INS_ADMIN_PASSWORD=admin
INS_AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Опционально: сессия Instagram для highlights.
# Инструкция — в secrets/README.md.
INS_INSTAGRAM_LOGIN=
INS_INSTAGRAM_SESSION_FILE=/secrets/instagram-session
