# Скопируйте в .env на VPS рядом с docker-compose.prod.yml.
# IMAGE_PREFIX/IMAGE_TAG обычно задаёт GitHub Actions, но их можно указать и здесь.

# Образы (owner/repo в нижнем регистре)
IMAGE_PREFIX=ghcr.io/owner/ins
IMAGE_TAG=latest

# Обязательно поменяйте
POSTGRES_PASSWORD=change-me
INS_ADMIN_PASSWORD=change-me
INS_AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Публичный адрес дашборда: нужен для CORS
INS_CORS_ORIGINS=https://ins.example.com

# Порты на хосте
INS_HTTP_PORT=8080
INS_API_PORT=8000

# Опционально: сессия Instagram для highlights (см. secrets/README.md)
INS_INSTAGRAM_LOGIN=
INS_INSTAGRAM_SESSION_FILE=/secrets/instagram-session
